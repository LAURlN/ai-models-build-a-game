{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "types": ["node"],
    "plugins": [],
    "paths": {
      "@t3tools/contracts": ["./packages/contracts/src/index.ts"],
      "@t3tools/contracts/*": ["./packages/contracts/src/*.ts"],
      "@t3tools/shared/*": ["./packages/shared/src/*.ts"],
      "@t3tools/provider-core/client": ["./packages/provider-core/src/client.ts"],
      "@t3tools/provider-core/server/*": ["./packages/provider-core/src/server/*.ts"],
      "@t3tools/provider-core/shared/*": ["./packages/provider-core/src/shared/*.ts"],
      "@t3tools/provider-acp/*": ["./packages/provider-acp/src/*.ts"],
      "@t3tools/secret-provider-core/*": ["./packages/secret-provider-core/src/*.ts"],
      "@t3tools/secret-provider-definitions/*": ["./packages/secret-provider-definitions/src/*.ts"],
      "@t3tools/secret-provider-onepassword/*": ["./packages/secret-provider-onepassword/src/*.ts"],
      "@t3tools/source-control-core/*": ["./packages/source-control-core/src/*.ts"],
      "effect-acp/schema-v1": ["./packages/effect-acp/src/_generated/schema-v1.gen.ts"],
      "effect-acp/*": ["./packages/effect-acp/src/*.ts"],
      "effect-codex-app-server/*": ["./packages/effect-codex-app-server/src/*.ts"],

      "node-pty": ["./stubs/node-pty.ts"],
      "playwright-core": ["./stubs/playwright-core.ts"],
      "ffi-rs": ["./stubs/ffi-rs.ts"],
      "@ff-labs/fff-node": ["./stubs/fff-node.ts"],
      "@anthropic-ai/claude-agent-sdk": ["./stubs/claude-agent-sdk.ts"],
      "@anthropic-ai/claude-agent-sdk/sdk-tools.d.ts": ["./stubs/claude-agent-sdk-tools.ts"],
      "@t3tools/tailscale": ["./stubs/tailscale.ts"],
      "@t3tools/tailscale/errors": ["./stubs/tailscale.ts"],
      "@t3tools/ssh-command": ["./stubs/ssh-command.ts"],
      "@t3tools/ssh-command/*": ["./stubs/ssh-errors.ts"],
      "@t3tools/ssh/command": ["./stubs/ssh-command.ts"],
      "@t3tools/ssh/errors": ["./stubs/ssh-errors.ts"],
      "@t3tools/document-parsers/*": ["./stubs/document-parsers.ts"],
      "stream-chain/defs.js": ["./stubs/document-parsers.ts"],
      "stream-json/core/assembler.js": ["./stubs/document-parsers.ts"],
      "stream-json/core/parser.js": ["./stubs/document-parsers.ts"],
      "character-entities": ["./stubs/document-parsers.ts"],
      "saxes": ["./stubs/document-parsers.ts"],
      "yauzl": ["./stubs/document-parsers.ts"],
      "remark-math": ["./stubs/remark.ts"],
      "remark-parse": ["./stubs/remark.ts"],
      "remark-gfm": ["./stubs/remark.ts"],
      "unified": ["./stubs/remark.ts"],

      "@t3tools/provider-acp-registry/*": ["./stubs/unused-acp-registry.ts"],
      "@t3tools/provider-cursor/*": ["./stubs/unused-providers.ts"],
      "@t3tools/provider-fx/*": ["./stubs/unused-providers.ts"],
      "@t3tools/provider-grok/*": ["./stubs/unused-providers.ts"],
      "@t3tools/provider-kiro/*": ["./stubs/unused-providers.ts"],
      "@t3tools/provider-muse/*": ["./stubs/unused-providers.ts"],
      "@t3tools/provider-opencode/server/OpenCodeServerLedger": ["./stubs/opencode-ledger.ts"],
      "@t3tools/provider-opencode/*": ["./stubs/unused-providers.ts"],
      "@t3tools/provider-pi/*": ["./stubs/unused-providers.ts"],

      "@t3tools/source-control-azure-devops/*": ["./stubs/unused-source-control.ts"],
      "@t3tools/source-control-bitbucket/*": ["./stubs/unused-source-control.ts"],
      "@t3tools/source-control-cursor-origin/*": ["./stubs/unused-source-control.ts"],
      "@t3tools/source-control-definitions/*": ["./stubs/unused-source-control.ts"],
      "@t3tools/source-control-forgejo/*": ["./stubs/unused-source-control.ts"],
      "@t3tools/source-control-gitcafe/*": ["./stubs/unused-source-control.ts"],
      "@t3tools/source-control-github/*": ["./stubs/unused-source-control.ts"],
      "@t3tools/source-control-gitlab/*": ["./stubs/unused-source-control.ts"]
    }
  },
  "include": [
    "apps/server/src/game/**/*.ts",
    "apps/server/src/ws.ts",
    "apps/server/src/auth/RpcAuthorization.ts",
    "apps/server/src/cli/config.ts",
    "apps/server/src/config.ts",
    "apps/server/src/textGeneration/TextGeneration.ts",
    "packages/contracts/src/game.ts",
    "packages/contracts/src/rpc.ts",
    "packages/contracts/src/index.ts",
    "packages/provider-core/src/server/textGeneration*.ts",
    "stubs/**/*.ts"
  ]
}
